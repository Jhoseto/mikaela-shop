{
  "name": "mikaela-shop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:start": "node scripts/postgres.mjs start",
    "db:stop": "node scripts/postgres.mjs stop",
    "migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "demo": "node scripts/demo.mjs",
    "owner": "tsx --env-file-if-exists=.env.local scripts/owner.ts",
    "worker": "tsx --env-file-if-exists=.env.local scripts/worker.ts",
    "backup": "tsx --env-file-if-exists=.env.local scripts/backup.ts backup",
    "restore": "tsx --env-file-if-exists=.env.local scripts/backup.ts restore",
    "test": "tsx --env-file-if-exists=.env.local --test tests/commerce.test.ts",
    "start:demo": "node --env-file=.env.demo.local node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3100",
    "brochure": "tsx --env-file-if-exists=.env.local scripts/import.ts",
    "worker:demo": "node --env-file=.env.demo.local --import tsx scripts/worker.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1169.0",
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/playfair-display": "5.3.0",
    "@fontsource-variable/roboto": "5.3.0",
    "@fontsource-variable/source-sans-3": "5.3.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@tesseract.js-data/bul": "1.0.0",
    "better-auth": "1.7.25",
    "cheerio": "1.2.0",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.73.0",
    "motion": "14.14.0",
    "next": "16.4.6",
    "nodemailer": "10.6.0",
    "pg": "8.23.1",
    "pg-boss": "12.38.2",
    "react": "^19.2",
    "react-dom": "^19.2",
    "sharp": "0.35.5",
    "tailwindcss": "^4.3.0",
    "tesseract.js": "7.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^24",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.14.1",
    "prettier": "^3.10.1",
    "tsx": "4.23.15",
    "typescript": "~5.9.3"
  }
}
